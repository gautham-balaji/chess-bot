# Copy to `.env` and adjust. `.env` is gitignored: it holds machine-specific paths.
# Environment variables exported in your shell take precedence over this file.

# Absolute path to the Stockfish executable.
# Only needed for the optional /benchmark endpoint - gameplay never uses Stockfish.
# If unset, the app looks for `stockfish` on PATH, then common install locations.
STOCKFISH_PATH=C:\path\to\stockfish.exe

# Optional: override where model files are loaded from.
# Defaults to <repo>/models
# CHESS_BOT_MODELS_DIR=/custom/path/to/models
